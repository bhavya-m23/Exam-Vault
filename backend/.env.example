# ExamVault Backend Configuration Example
# Copy this file to .env and customize for your environment.

# Server Port
PORT=5000

# Environment: development, test, production
NODE_ENV=development

# JWT Secret Key (In production, generate a strong random 32+ character string)
JWT_SECRET=examvault-dev-secret-do-not-use-in-production-32chars-min
JWT_EXPIRES_IN=8h

# Demo Persona Switching (Allows 1-click evaluator role testing for presentations)
# Set to 'false' in production environments
ENABLE_DEMO_SWITCH=true

# Database Path (Optional, defaults to backend/data/examvault.db)
# DATABASE_PATH=./data/examvault.db
